# Netlify Functions contact form (set these in Netlify UI for production)
# For local: copy to .env and fill in. Never commit .env.

# Frontend -> Backend (OPTION A: Netlify Functions)
# Production: leave unset → same origin (''). /api/* redirects to /.netlify/functions/*
# Development: netlify dev runs on 8888; leave unset to use http://localhost:8888
# If you run only CRA (npm start on 3000), set REACT_APP_API_URL=http://localhost:8888 to hit netlify dev
# REACT_APP_API_URL=

SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_16_char_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# Optional: generic SMTP instead of Gmail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
